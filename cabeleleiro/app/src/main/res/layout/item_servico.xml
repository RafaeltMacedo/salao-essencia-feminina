<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/cor_fundo_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeServico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cor_dourado"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Corte Feminino" />

            <TextView
                android:id="@+id/txtPrecoServico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/cor_texto_secundario"
                android:textSize="14sp"
                tools:text="R$ 16,00" />

        </LinearLayout>

        <Button
            android:id="@+id/btEditarServico"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="@color/cor_dourado"
            android:text="Editar"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <Button
            android:id="@+id/btExcluirServico"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/cor_perigo"
            android:text="Excluir"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
