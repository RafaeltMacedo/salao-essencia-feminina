{
  "rules": {
    "usuarios": {
      ".indexOn": ["tipo"],
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!data.child('tipo').exists() || newData.child('tipo').exists()",
        "tipo": {
          ".validate": "newData.isString() && (newData.val() === data.val() || (!data.exists() && newData.val() === 'cliente'))"
        }
      }
    },
    "agendamentos": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'cabeleireira'",
      "$agendamentoId": {
        ".write": "auth != null && (root.child('usuarios').child(auth.uid).child('tipo').val() === 'cabeleireira' || (!data.exists() && newData.child('clienteUid').val() === auth.uid) || (data.exists() && data.child('clienteUid').val() === auth.uid))"
      }
    },
    "agendamentos_por_cliente": {
      "$clienteUid": {
        ".read": "auth != null && auth.uid === $clienteUid",
        ".write": "auth != null && (auth.uid === $clienteUid || root.child('usuarios').child(auth.uid).child('tipo').val() === 'cabeleireira')"
      }
    },
    "horarios_ocupados": {
      ".read": "auth != null",
      "$data": {
        "$hora": {
          ".write": "auth != null && ( root.child('usuarios').child(auth.uid).child('tipo').val() === 'cabeleireira' || ( (!data.exists() || data.val() === auth.uid) && (!newData.exists() || newData.val() === auth.uid) ) )",
          ".validate": "newData.isString()"
        }
      }
    },
    "servicos": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'cabeleireira'"
    },
    "configuracoes": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() === 'cabeleireira'"
    }
  }
}
